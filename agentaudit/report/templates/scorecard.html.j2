<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AgentAudit Scorecard — {{ card.agent_path }}</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>
  body { background:#0b1120; color:#e2e8f0; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .card { background:#111827; border:1px solid #1f2937; }
  .diff-add { color:#4ade80; } .diff-del { color:#f87171; }
  code, pre { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
</style>
</head>
<body class="min-h-screen">
<div class="max-w-5xl mx-auto p-6">

  <!-- Header -->
  <header class="flex items-center justify-between mb-8 pb-6 border-b border-gray-800">
    <div>
      <div class="text-sm tracking-widest text-emerald-400">AGENTAUDIT · SECURITY SCORECARD</div>
      <h1 class="text-2xl font-bold mt-1 break-all">{{ card.agent_path }}</h1>
      <div class="text-gray-400 text-sm mt-1">
        {{ card.generated_at }} · v{{ card.tool_version }} ·
        {{ card.findings|length }} finding(s) across {{ card.layers_with_findings() }} layer(s)
      </div>
    </div>
    <div class="text-center">
      <div class="rounded-2xl w-28 h-28 flex items-center justify-center"
           style="background:{{ grade_color[card.grade] }}20; border:3px solid {{ grade_color[card.grade] }}">
        <span class="text-6xl font-black" style="color:{{ grade_color[card.grade] }}">{{ card.grade }}</span>
      </div>
      <div class="mt-2 text-sm text-gray-400">risk {{ card.score }}/100</div>
    </div>
  </header>

  <!-- Severity summary -->
  <section class="grid grid-cols-5 gap-3 mb-6">
    {% for sev, n in card.counts_by_severity().items() %}
    <div class="card rounded-xl p-3 text-center">
      <div class="text-2xl font-bold" style="color:{{ sev_color[sev] }}">{{ n }}</div>
      <div class="text-xs uppercase tracking-wider text-gray-400">{{ sev }}</div>
    </div>
    {% endfor %}
  </section>

  <!-- Layer status -->
  <section class="grid grid-cols-3 gap-3 mb-8">
    {% for lr in card.layer_reports %}
    <div class="card rounded-xl p-4">
      <div class="flex items-center justify-between">
        <span class="font-semibold capitalize">{{ lr.layer.value }}</span>
        {% if lr.status == 'ran' %}
          <span class="text-xs px-2 py-0.5 rounded bg-emerald-900 text-emerald-300">RAN</span>
        {% elif lr.status == 'skipped' %}
          <span class="text-xs px-2 py-0.5 rounded bg-gray-700 text-gray-300">SKIPPED</span>
        {% else %}
          <span class="text-xs px-2 py-0.5 rounded bg-red-900 text-red-300">ERROR</span>
        {% endif %}
      </div>
      <div class="text-xs text-gray-400 mt-2">{{ lr.detail }}</div>
    </div>
    {% endfor %}
  </section>

  <!-- Findings -->
  <h2 class="text-lg font-bold mb-4 text-gray-200">Findings</h2>
  {% if not card.findings %}
    <div class="card rounded-xl p-8 text-center text-emerald-400">
      ✓ No findings. This agent passed all enabled checks.
    </div>
  {% endif %}
  {% for f in card.findings %}
  <article class="card rounded-xl p-5 mb-4">
    <div class="flex items-start justify-between gap-4">
      <div>
        <span class="text-xs font-bold px-2 py-0.5 rounded uppercase"
              style="background:{{ sev_color[f.severity.value] }}22; color:{{ sev_color[f.severity.value] }}">
          {{ f.severity.value }}
        </span>
        <span class="text-xs text-gray-500 ml-2">{{ f.layer.value }} · {{ f.detector }} · {{ f.confidence.value }}</span>
        <h3 class="font-semibold mt-2">{{ f.title }}</h3>
      </div>
      <span class="text-xs text-gray-500 whitespace-nowrap">{{ f.location }}</span>
    </div>
    <p class="text-sm text-gray-300 mt-3 leading-relaxed">{{ f.description }}</p>
    {% if f.evidence %}
    <div class="mt-3 text-xs">
      <span class="text-gray-500">evidence:</span>
      <code class="text-amber-300">{{ f.evidence }}</code>
    </div>
    {% endif %}
    {% if f.remediation %}
    <div class="mt-4 border-t border-gray-800 pt-3">
      <div class="text-xs text-emerald-400 mb-2">▸ FIX: {{ f.remediation.summary }}</div>
      {% if f.remediation.before or f.remediation.after %}
      <pre class="text-xs bg-black/40 rounded p-3 overflow-x-auto">{% for line in f.remediation.before.split('\n') %}<span class="diff-del">- {{ line }}</span>
{% endfor %}{% for line in f.remediation.after.split('\n') %}<span class="diff-add">+ {{ line }}</span>
{% endfor %}</pre>
      {% endif %}
    </div>
    {% endif %}
  </article>
  {% endfor %}

  <footer class="text-center text-xs text-gray-600 mt-10 pt-6 border-t border-gray-800">
    Generated by AgentAudit · Your agent passed the demo. Did it pass the pentest?
    {% if card.signature %}<br>signed: {{ card.signature.hmac[:16] }}…{% endif %}
  </footer>
</div>
</body>
</html>
