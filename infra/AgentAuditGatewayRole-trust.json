{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAgentCoreGatewayAssume",
      "Effect": "Allow",
      "Principal": {
        "Service": "bedrock-agentcore.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "580912381651"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:bedrock-agentcore:eu-north-1:580912381651:gateway/*"
        }
      }
    }
  ]
}
